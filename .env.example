# --- General Configuration ---
DOMAIN=http://localhost:8080
SECRET=replace_with_a_secure_random_string

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mycatatankuliah
DATABASE_URL=postgres://postgres:postgres@db:5432/mycatatankuliah

# --- Messaging (NATS) ---
NATS_URL=nats://nats:4222

# --- Cache (Redis) ---
REDIS_URL=redis://redis:6379

# --- Storage (MinIO / S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=mycatatankuliah

# --- Authentication (Google OAuth) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Real-time Collaboration (Hocuspocus) ---
HOCUSPOCUS_PORT=3005
HOCUSPOCUS_URL=http://hocuspocus:3005

# --- AI Service ---
AI_SERVICE_URL=http://ai:3000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=minimaxai/minimax-m2.7

# --- Embedder ---
CHUNK_SIZE=500
