layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Dev Dashboard" split_direction="vertical" {
        // Left Column (2 panes)
        pane split_direction="horizontal" {
            pane name="backend" command="task" {
                args "backend"
            }
            pane name="frontend" command="task" {
                args "frontend"
            }
        }
        // Right Column (3 panes)
        pane split_direction="horizontal" {
            pane name="hocuspocus" command="task" {
                args "hocuspocus"
            }
            pane name="ai" command="task" {
                args "ai"
            }
            pane name="embedder" command="task" {
                args "embedder"
            }
        }
    }
}